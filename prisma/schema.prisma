// PropEdge AI — Prisma schema (SQLite, local-first)
// Note: SQLite does not support Prisma enums, so status/direction/etc. are stored as
// Strings and validated in the app layer (see src/types/index.ts for the allowed unions).
// JSON payloads are stored as String (JSON.stringify) for portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlayerProp {
  id              String    @id @default(cuid())
  date            String // slate date, "YYYY-MM-DD"
  sport           String
  league          String
  playerName      String
  team            String // NOTE: for Odds API props this is the HOME team, not the player's
  opponent        String
  // The player's own team (ESPN team id), resolved during scoring. `team` above
  // cannot serve this purpose, so this is what tells us two players are
  // team-mates — which pick'em entries are not allowed to contain.
  playerTeamId    String?
  // ESPN athlete id, resolved from ESPN team rosters when the prop is scored
  // (or by research:skill). Grading joins it to nflverse ids (espn_id ->
  // gsis_id), so a feed spelling never decides which player a prop belongs to.
  espnAthleteId   String?
  gameId          String?
  gameStartTime   DateTime?
  propType        String
  line            Float // sharp-market consensus line (from The Odds API)
  underdogLine    Float? // the line Underdog actually offers (user-entered)
  // When the current Underdog line arrived and where from ("feed" | "manual"),
  // recorded from 2026-10-21 on (null before: unknown). A line typed after
  // kickoff, or after the market moved, can then be told apart.
  underdogLineAt     DateTime?
  underdogLineSource String?
  // Whether the pick'em platform posts this prop at all. Props come from a
  // sportsbook feed, which carries markets and players pick'em sites do not, so
  // the board can otherwise recommend a bet that cannot be placed. Three states
  // on purpose: null = nobody has looked, true = seen on the platform,
  // false = confirmed absent. Only an observation sets this, never a guess.
  underdogAvailable Boolean?
  // Underdog's per-pick payout tag: below 1 (e.g. 0.85) on a side it judges
  // likely, above 1 on an unlikely one. It multiplies the whole entry's payout,
  // and lands hardest on exactly the lopsided picks the model likes most. Null
  // means standard (1.0) or not yet entered.
  underdogPickMultiplier Float?
  direction       String // OVER | UNDER
  source          String
  projection      Float?
  payoutMultiplier Float?
  injuryStatus    String?
  notes           String?
  marketDataJson  String? // The Odds API snapshot: no-vig prob, book lines, book count
  status          String    @default("pending") // pending | hit | miss | push | void
  actualResult    Float?
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  picks         Pick[]
  predictions   PropPrediction[]

  @@index([date])
  @@index([sport])
}

// One forecast of one prop at one moment: the model's and the books' P(over)
// at the same line, so the model can be scored against the market rather than
// a coin flip. Every scored prop gets a row, not just picks. Rows from
// different sources, model versions or market methods are never pooled.
model PropPrediction {
  id             String     @id @default(cuid())
  playerPropId   String
  playerProp     PlayerProp @relation(fields: [playerPropId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  quotedAt       DateTime // when the market data behind the row was fetched
  line           Float
  lineKind       String // reference (the books' own line) | venue (the line played)
  modelProbOver  Float // model P(over), after the production clip on the side it favours
  modelRawProbOver Float? // the same before the clip, for diagnostics
  marketProbOver Float // de-vigged consensus P(over) at the same line
  marketMethod   String // consensus-v2 (per-book quotes) | novig-v1 (one stored probability)
  modelVersion   String
  source         String // live | backfill
  edgeSource     String // venue | news | model | unknown
  playerStatus   String? // injury status when scored, for the news rule
  teammateOut    Boolean? // a teammate absence was boosting the player when scored

  @@index([playerPropId, createdAt])
  @@index([source, modelVersion])
}

model Pick {
  // Books' no-vig probability of this side at the line being played (v1.5.0+).
  marketProb         Float?
  id                 String   @id @default(cuid())
  playerPropId       String
  playerProp         PlayerProp @relation(fields: [playerPropId], references: [id], onDelete: Cascade)
  date               String
  confidenceScore    Float
  edgeScore          Float
  riskLevel          String // Low | Medium | High
  rank               Int
  recommendedStake   Float
  reasoningSummary   String
  deepDiveAnalysis   String
  verdict            String   @default("")
  scoreBreakdownJson String   @default("{}")
  evidenceJson       String   @default("[]")
  warningsJson       String   @default("[]")
  reasonsForJson     String   @default("[]")
  reasonsAgainstJson String   @default("[]")
  tagsJson           String   @default("[]")
  userNote           String?
  modelVersion       String   @default("v1.0.0")
  // Which engine produced `confidenceScore`. Only "distribution" makes it an
  // actual probability, so calibration metrics must be scoped to those picks.
  scoringProfile     String   @default("balanced")
  status             String   @default("pending") // pending | hit | miss | push | void
  actualResult       Float?
  placedReal         Boolean  @default(false)
  isDemo             Boolean  @default(false)
  // Closing-line value: no-vig probability of the chosen side at pick time (entry)
  // and near game start (closing). CLV = closingProb − entryProb.
  entryProb          Float?
  closingProb        Float?
  closingCapturedAt  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  evidence        Evidence[]
  bankrollEntries BankrollEntry[]
  parlayLegs      ParlayLeg[]

  @@index([date])
  @@index([status])
}

model Evidence {
  id               String   @id @default(cuid())
  pickId           String
  pick             Pick     @relation(fields: [pickId], references: [id], onDelete: Cascade)
  category         String
  title            String
  summary          String
  sourceUrl        String?
  sourceName       String?
  confidenceImpact Float    @default(0) // -100..100, effect on confidence
  createdAt        DateTime @default(now())
}

model BankrollEntry {
  id         String   @id @default(cuid())
  date       String
  pickId       String?
  pick         Pick?    @relation(fields: [pickId], references: [id], onDelete: SetNull)
  parlayId     String?
  teamPickId   String?
  teamParlayId String?
  entryType  String // single | parlay | manual_adjustment | moneyline | team_parlay
  stake      Float    @default(0)
  payout     Float    @default(0)
  profitLoss Float    @default(0)
  status     String   @default("pending") // pending | won | lost | push | void
  placedReal Boolean  @default(false)
  notes      String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([date])
}

model Parlay {
  id              String   @id @default(cuid())
  date            String
  name            String
  stake           Float    @default(5)
  payoutMultiplier Float   @default(1)
  projectedPayout Float    @default(0)
  actualPayout    Float?
  profitLoss      Float?
  status          String   @default("pending") // pending | won | lost | void
  placedReal      Boolean  @default(false)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  legs ParlayLeg[]

  @@index([date])
}

model ParlayLeg {
  id       String @id @default(cuid())
  parlayId String
  parlay   Parlay @relation(fields: [parlayId], references: [id], onDelete: Cascade)
  pickId   String
  pick     Pick   @relation(fields: [pickId], references: [id], onDelete: Cascade)
  status   String @default("pending") // pending | hit | miss | push | void
}

model AppSettings {
  id                     String   @id @default("singleton")
  defaultStake           Float    @default(5)
  bankrollStartingAmount Float    @default(100)
  sportsEnabledJson      String   @default("[\"NFL\",\"NBA\",\"NCAAB\",\"MLB\",\"WNBA\",\"NHL\",\"Soccer\"]")
  minConfidenceThreshold Int      @default(65)
  maxDailyPicks          Int      @default(10)
  demoMode               Boolean  @default(true)
  enableWebResearch      Boolean  @default(false)
  scoringProfile         String   @default("balanced") // balanced | market
  leaguesEnabledJson     String   @default("[\"NFL\",\"MLB\",\"CBB\",\"WNBA\",\"EPL\",\"Bundesliga\",\"UCL\",\"WorldCup\"]")
  minTeamConfidence      Int      @default(55)
  // NFL gameday: which Odds API prop markets to pull (each costs 1 credit per game),
  // how many games per slate at most, and the credit balance we refuse to go below.
  nflMarketsJson         String   @default("[\"Passing Yards\",\"Rushing Yards\",\"Receiving Yards\",\"Receptions\",\"Pass TDs\",\"Rush+Rec Yards\"]")
  nflMaxGames            Int      @default(16)
  oddsCreditFloor        Int      @default(25)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Persistent key/value cache for free-provider payloads (ESPN game summaries,
// weather, aggregated defense stats, last-known Odds API credit balance). Shared
// between the web app and the headless daily job, which run as separate processes.
model ProviderCache {
  key       String   @id
  json      String
  updatedAt DateTime @updatedAt
}

// Team (moneyline / game-winner) recommendation.
model TeamPick {
  id                 String   @id @default(cuid())
  date               String // slate date "YYYY-MM-DD"
  league             String // NFL | MLB | CBB | WNBA | EPL | Bundesliga | UCL | WorldCup
  homeTeam           String
  awayTeam           String
  gameId             String?
  gameStartTime      DateTime?
  recommendedSide    String // HOME | AWAY | DRAW
  recommendedTeam    String
  winProbability     Float // model, 0..1
  marketWinProb      Float // de-vig market, 0..1
  valueEdge          Float // model - market
  priceAmerican      Float?
  confidenceScore    Float
  edgeScore          Float    @default(0)
  riskLevel          String // Low | Medium | High
  rank               Int      @default(0)
  reasoningSummary   String   @default("")
  deepDiveAnalysis   String   @default("")
  verdict            String   @default("")
  scoreBreakdownJson String   @default("{}")
  evidenceJson       String   @default("[]")
  warningsJson       String   @default("[]")
  reasonsForJson     String   @default("[]")
  reasonsAgainstJson String   @default("[]")
  tagsJson           String   @default("[]")
  userNote           String?
  modelVersion       String   @default("v1.0.0")
  status             String   @default("pending") // pending | win | loss | push | void
  actualWinner       String? // HOME | AWAY | DRAW
  placedReal         Boolean  @default(false)
  isDemo             Boolean  @default(false)
  // Closing-line value: de-vig win prob of the recommended side near game start.
  // Entry = marketWinProb (above). CLV = closingWinProb − marketWinProb.
  closingWinProb     Float?
  closingPrice       Float?
  closingCapturedAt  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parlayLegs TeamParlayLeg[]

  @@index([date])
  @@index([league])
  @@index([status])
}

// Moneyline parlay: combine multiple team-to-win picks. Payout is derived from
// the legs' American prices (product of decimal odds), not a manual multiplier.
model TeamParlay {
  id              String   @id @default(cuid())
  date            String
  name            String
  stake           Float    @default(5)
  combinedDecimal Float    @default(1) // product of leg decimal odds
  combinedAmerican Int     @default(100)
  projectedPayout Float    @default(0) // total return incl. stake if all legs win
  actualPayout    Float?
  profitLoss      Float?
  status          String   @default("pending") // pending | won | lost | push | void
  placedReal      Boolean  @default(false)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  legs TeamParlayLeg[]

  @@index([date])
}

model TeamParlayLeg {
  id            String     @id @default(cuid())
  teamParlayId  String
  teamParlay    TeamParlay @relation(fields: [teamParlayId], references: [id], onDelete: Cascade)
  teamPickId    String
  teamPick      TeamPick   @relation(fields: [teamPickId], references: [id], onDelete: Cascade)
  priceAmerican Float? // snapshot of the leg's moneyline price at build time
  status        String     @default("pending") // pending | win | loss | push | void
}

// Reserved for future line-movement tracking (multiple snapshots per prop).
// "Avoid list": players / prop types the model has performed poorly on.
model AvoidListItem {
  id        String   @id @default(cuid())
  type      String // player | propType
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([type, value])
}

// Every player-prop quote we fetch, kept with the time we fetched it, so the
// consensus can be rebuilt as of any moment we hold data for (backtests,
// closing-line value, line movement). Append-only. History starts 2026-10-20:
// earlier odds would need The Odds API's paid historical tier.
model OddsQuote {
  id            String    @id @default(cuid())
  fetchedAt     DateTime
  fetchKind     String // slate (the gameday fetch) | closing (the pre-kickoff capture)
  sportKey      String
  eventId       String
  commenceTime  DateTime
  homeTeam      String
  awayTeam      String
  playerName    String
  propType      String
  book          String
  line          Float
  over          Int? // American odds; null when the book posted one side only
  under         Int?
  bookUpdatedAt DateTime? // the book's own last_update for the market

  @@index([eventId, playerName, propType, fetchedAt])
  @@index([fetchedAt])
}

// Every change in a player's game injury-report status, with when we first saw
// it (ESPN, free; polled by the 15-minute schedulers). The news-latency test
// measures, from here, how long each venue takes to move teammates' lines.
model InjuryStatusChange {
  id          String   @id @default(cuid())
  detectedAt  DateTime
  eventId     String // ESPN event id
  kickoff     DateTime
  team        String
  playerName  String
  position    String?
  fromStatus  String? // null the first time a player is seen on the report
  toStatus    String // active | questionable | doubtful | out | gtd | cleared (dropped off the report)
  rawStatus   String?

  @@index([eventId, team, playerName, detectedAt])
  @@index([toStatus, detectedAt])
}

// The news-fetch trial (2026-10-20 → 10-27, 30 credits): after a running back
// is ruled Out, the affected game's rushing markets are bought twice — ~10 and
// ~40 minutes after the change was first seen — so each venue's reaction is
// bracketed. One row per planned fetch; both are reserved together.
model NewsFetch {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  changeId        String // InjuryStatusChange.id
  window          String // friday (the final injury report) | inactives (within 2h of kickoff)
  eventId         String // ESPN event id
  homeTeam        String
  awayTeam        String
  kickoff         DateTime
  team            String
  playerName      String
  seq             Int // 1 (~10 min) or 2 (~40 min)
  dueAt           DateTime
  status          String // queued | done | skipped | failed
  creditsReserved Int
  creditsSpent    Int?
  quotes          Int?
  note            String?
  executedAt      DateTime?

  @@index([status, dueAt])
}

// Every Odds API request that cost credits: its exact cost (x-requests-last),
// the balance after it, and what kind of fetch made it. Written where every
// request passes through, so nothing can spend without a line here; a call
// site that forgets to say what it is logs as "untagged".
model CreditSpend {
  id        String   @id @default(cuid())
  at        DateTime
  kind      String // slate | alt | closing | closing-moneyline | news | team-picks | manual | daily | untagged
  credits   Int? // null: the request timed out or failed, so its cost is unknown (it may still have been charged)
  remaining Int?
  endpoint  String // the request path and markets, API key removed
  status    Int

  @@index([at])
}
